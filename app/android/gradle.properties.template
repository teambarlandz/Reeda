# Project-wide Gradle settings (template — copy to gradle.properties on first build).
# Machine-local / secret values (sdk.dir, release keystore, passwords) must NOT go here.

org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m

# AndroidX package structure
android.useAndroidX=true
# Automatically convert third-party libraries to use AndroidX
android.enableJetifier=true

# Build all four ABIs; narrow with -PreactNativeArchitectures for faster local builds
reactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64

# New Architecture (Fabric/TurboModules)
newArchEnabled=false

# Hermes JS engine (false ⇒ JSC)
hermesEnabled=true

# FTS5 in bundled SQLite — required by books_fts search (phase-2.md:5.1.1)
quickSqliteFlags="-DSQLITE_ENABLE_FTS5"